generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & RBAC
// ============================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         UserRole[]
  assignedWOs   WorkOrder[]       @relation("AssignedTechnician")
  supervisedWOs WorkOrder[]       @relation("Supervisor")
  reportedWOs   WorkOrder[]       @relation("ReportedBy")
  woChecklists  WorkOrderChecklist[]
  woAttachments WorkOrderAttachment[]
  woSpareParts  WorkOrderSparePart[]
  auditLogs     AuditLog[]
  notifications Notification[]
  meterReadings AssetMeterReading[]
  documents     AssetDocument[]
  integrationLogs IntegrationLog[]
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]
}

model UserRole {
  id        String @id @default(uuid())
  userId    String
  roleId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================================
// ASSETS
// ============================================================

model Asset {
  id            String   @id @default(uuid())
  assetCode     String   @unique
  assetName     String
  assetType     String
  location      String
  serialNumber  String?
  manufacturer  String?
  model         String?
  purchaseDate  DateTime?
  warrantyStart DateTime?
  warrantyEnd   DateTime?
  status        String   @default("ACTIVE")
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents     AssetDocument[]
  meters        AssetMeter[]
  meterReadings AssetMeterReading[]
  workOrders    WorkOrder[]
  preventiveMaintenance PreventiveMaintenance[]
  spareParts    WorkOrderSparePart[]
}

model AssetDocument {
  id          String   @id @default(uuid())
  assetId     String
  filename    String
  type        String
  path        String
  size        Int
  uploadedBy  String
  uploadedAt  DateTime @default(now())

  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploader    User     @relation(fields: [uploadedBy], references: [id])
}

model AssetMeter {
  id          String   @id @default(uuid())
  assetId     String
  meterType   String
  unit        String
  description String?
  createdAt   DateTime @default(now())

  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  readings    AssetMeterReading[]
}

model AssetMeterReading {
  id          String   @id @default(uuid())
  meterId     String
  assetId     String
  value       Float
  readingDate DateTime @default(now())
  recordedBy  String

  meter       AssetMeter   @relation(fields: [meterId], references: [id], onDelete: Cascade)
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  recorder    User         @relation(fields: [recordedBy], references: [id])
}

// ============================================================
// WORK ORDERS
// ============================================================

model WorkOrder {
  id                String    @id @default(uuid())
  woNumber          String    @unique
  title             String
  description       String?
  assetId           String?
  location          String?
  reportedById      String
  supervisorId      String?
  assignedToId      String?
  priority          String    @default("MEDIUM")
  status            String    @default("OPEN")
  dueDate           DateTime?
  createdAt         DateTime  @default(now())
  assignedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  closedAt          DateTime?
  problemDescription String?
  repairInstruction  String?
  workPerformed      String?
  rootCause          String?
  resolution         String?
  notes              String?

  asset             Asset?          @relation(fields: [assetId], references: [id])
  reportedBy        User            @relation("ReportedBy", fields: [reportedById], references: [id])
  supervisor        User?           @relation("Supervisor", fields: [supervisorId], references: [id])
  assignedTechnician User?          @relation("AssignedTechnician", fields: [assignedToId], references: [id])

  statusHistory     WorkOrderStatusHistory[]
  checklists        WorkOrderChecklist[]
  attachments       WorkOrderAttachment[]
  spareParts        WorkOrderSparePart[]
}

model WorkOrderStatusHistory {
  id          String   @id @default(uuid())
  woId        String
  fromStatus  String?
  toStatus    String
  changedBy   String
  notes       String?
  createdAt   DateTime @default(now())

  workOrder   WorkOrder @relation(fields: [woId], references: [id], onDelete: Cascade)
}

model WorkOrderChecklist {
  id          String    @id @default(uuid())
  woId        String
  title       String
  description String?
  required    Boolean   @default(true)
  completed   Boolean   @default(false)
  completedBy String?
  completedAt DateTime?
  notes       String?

  workOrder   WorkOrder @relation(fields: [woId], references: [id], onDelete: Cascade)
  completer   User?     @relation(fields: [completedBy], references: [id])
}

model WorkOrderAttachment {
  id          String   @id @default(uuid())
  woId        String
  filename    String
  originalName String
  mimeType    String
  path        String
  size        Int
  uploadedBy  String
  createdAt   DateTime @default(now())

  workOrder   WorkOrder @relation(fields: [woId], references: [id], onDelete: Cascade)
  uploader    User      @relation(fields: [uploadedBy], references: [id])
}

model WorkOrderSparePart {
  id              String   @id @default(uuid())
  woId            String
  itemId          String
  plannedQuantity Float?
  usedQuantity    Float?
  unit            String
  unitCost        Float    @default(0)
  totalCost       Float    @default(0)
  createdAt       DateTime @default(now())

  workOrder       WorkOrder  @relation(fields: [woId], references: [id], onDelete: Cascade)
  item            SparePart  @relation(fields: [itemId], references: [id])
}

// ============================================================
// PREVENTIVE MAINTENANCE
// ============================================================

model PreventiveMaintenance {
  id              String    @id @default(uuid())
  assetId         String
  title           String
  description     String?
  frequency       String    @default("MONTHLY")
  customIntervalDays Int?
  startDate       DateTime
  nextDueDate     DateTime
  meterType       String?
  meterThreshold  Float?
  assignedToId    String?
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  asset           Asset              @relation(fields: [assetId], references: [id])
  assignedTechnician User?           @relation(fields: [assignedToId], references: [id])
  checklists      PreventiveMaintenanceChecklist[]
  logs            PreventiveMaintenanceLog[]
  generatedWOs    PreventiveMaintenanceWO[]
}

model PreventiveMaintenanceChecklist {
  id          String   @id @default(uuid())
  pmId        String
  title       String
  description String?
  required    Boolean  @default(true)
  createdAt   DateTime @default(now())

  pm          PreventiveMaintenance @relation(fields: [pmId], references: [id], onDelete: Cascade)
}

model PreventiveMaintenanceLog {
  id          String   @id @default(uuid())
  pmId        String
  woId        String?
  completedAt DateTime @default(now())
  notes       String?

  pm          PreventiveMaintenance @relation(fields: [pmId], references: [id], onDelete: Cascade)
}

model PreventiveMaintenanceWO {
  id          String   @id @default(uuid())
  pmId        String
  woId        String
  createdAt   DateTime @default(now())

  pm          PreventiveMaintenance @relation(fields: [pmId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder             @relation(fields: [woId], references: [id], onDelete: Cascade)

  @@unique([pmId, woId])
}

// ============================================================
// INVENTORY
// ============================================================

model SparePart {
  id              String   @id @default(uuid())
  itemCode        String   @unique
  itemName        String
  category        String?
  specification   String?
  unit            String   @default("PCS")
  warehouseId     String?
  stockLocation   String?
  currentStock    Float    @default(0)
  minimumStock    Float    @default(0)
  maximumStock    Float    @default(0)
  unitCost        Float    @default(0)
  zahirItemId     String?
  lastSync        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  transactions    InventoryTransaction[]
  woSpareParts    WorkOrderSparePart[]
  purchaseRequisitions PurchaseRequisition[]
}

model Warehouse {
  id          String   @id @default(uuid())
  name        String   @unique
  location    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spareParts  SparePart[]
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  itemId          String
  warehouseId     String
  transactionType String
  quantity        Float
  unitCost        Float    @default(0)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())

  item            SparePart  @relation(fields: [itemId], references: [id])
  warehouse       Warehouse  @relation(fields: [warehouseId], references: [id])
  creator         User       @relation(fields: [createdBy], references: [id])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  message     String
  referenceType String?
  referenceId   String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// PURCHASE REQUISITIONS
// ============================================================

model PurchaseRequisition {
  id              String   @id @default(uuid())
  itemId          String
  quantity        Float
  unit            String
  reason          String?
  currentStock    Float
  minimumStock    Float
  status          String   @default("DRAFT")
  externalPrId    String?
  syncStatus      String?
  syncError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item            SparePart @relation(fields: [itemId], references: [id])
}

// ============================================================
// ZAHIR INTEGRATION
// ============================================================

model IntegrationConfig {
  id              String   @id @default(uuid())
  key             String   @unique
  value           String?
  encrypted       Boolean  @default(false)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model IntegrationJob {
  id              String   @id @default(uuid())
  type            String
  referenceType   String?
  referenceId     String?
  payload         String
  status          String   @default("PENDING")
  attempts        Int      @default(0)
  maxAttempts     Int      @default(5)
  nextRetryAt     DateTime?
  lastError       String?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  processedAt     DateTime?
}

model IntegrationLog {
  id              String   @id @default(uuid())
  type            String
  endpoint        String?
  requestId       String?
  referenceType   String?
  referenceId     String?
  status          String
  responseStatus  Int?
  responseMessage String?
  duration        Int?
  createdAt       DateTime @default(now())

  user            User?    @relation(fields: [referenceId], references: [id])
}

model WebhookEvent {
  id              String   @id @default(uuid())
  externalEventId String?  @unique
  source          String
  eventType       String
  payload         String
  status          String   @default("RECEIVED")
  processedAt     DateTime?
  error           String?
  createdAt       DateTime @default(now())
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  oldValue    String?
  newValue    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
}
